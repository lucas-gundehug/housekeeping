# Copy this file to .env.local and fill in the values you need.

# A real passphrase (not a 4-digit code): this tool has service-role access to
# the personal dashboard's database, so it's more sensitive than the
# dashboard's own login. Generate a high-entropy one, e.g.
# `openssl rand -base64 24`.
HOUSEKEEPING_PASSPHRASE=

# Signs the login token together with the passphrase above. Required (no
# fallback) — generate with `openssl rand -hex 32`.
HOUSEKEEPING_TOKEN_SECRET=

# The personal dashboard's Supabase project (training data, the /training
# section). The same URL/key as the dashboard's own SUPABASE_URL /
# SUPABASE_SERVICE_ROLE_KEY — see personal-dashboard-supabase.ts.
PERSONAL_DASHBOARD_SUPABASE_URL=
PERSONAL_DASHBOARD_SUPABASE_SERVICE_ROLE_KEY=

# The personal dashboard's address and admin API (changing its 4-digit access
# code from the Admin tab, plus the Health page). Called with a shared static
# secret; set the same value as HOUSEKEEPING_SERVICE_SECRET on the dashboard.
# See personal-dashboard-client.ts.
PERSONAL_DASHBOARD_BASE_URL=
PERSONAL_DASHBOARD_SERVICE_SECRET=

# Set automatically when you connect an Upstash Redis database through
# Vercel's Storage tab (or use UPSTASH_REDIS_REST_URL/_TOKEN when connecting to
# Upstash directly). Lets a passphrase changed from the Admin tab survive
# restarts; without it the change lives in memory only.
KV_REST_API_URL=
KV_REST_API_TOKEN=
